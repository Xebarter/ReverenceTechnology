# Copy to .env and fill in. Never commit real .env.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Firebase Auth (client)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin is optional. Sign-in, /admin, and API auth use the client ID token
# (verified with Google's public keys). You do not need a service account.
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=

# After someone signs in once, grant /admin with:
#   npm run grant-admin -- you@example.com

# Also enable Firebase as a third-party auth provider in the Supabase dashboard
# (Authentication → Third-party) so RLS auth.jwt() works with Firebase ID tokens.

# Optional: comma-separated origins for order API CORS
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Hosted checkout (Network International merchant credentials)
# NEXT_PUBLIC_APP_URL=https://yourdomain.com
HOSTED_CHECKOUT_COMPANY_TOKEN=
HOSTED_CHECKOUT_SERVICE_TYPE=
# Optional overrides:
# HOSTED_CHECKOUT_CURRENCY=UGX
# HOSTED_CHECKOUT_API_URL=https://secure.3gdirectpay.com/API/v6/
# HOSTED_CHECKOUT_PAY_URL=https://secure.3gdirectpay.com/payv2.php
# HOSTED_CHECKOUT_PTL_HOURS=24
